{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "TeamCreate",
      "TeamDelete",
      "Skill",
      "Bash"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/key/**)",
      "Read(~/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(glab mr create:*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(sudo *)"
    ],
    "defaultMode": "plan"
  },
  "model": "Opus",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh /Users/onodaosamu/.claude/statusline-command.sh"
  },
  "language": "japanese",
  "spinnerTipsEnabled": false,
  "tui": "fullscreen",
  "theme": "dark",
  "useAutoModeDuringPlan": false,
  "voiceEnabled": true
}
