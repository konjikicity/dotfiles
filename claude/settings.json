{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "TeamCreate",
      "TeamDelete",
      "Skill",
      "Bash(*)",
      "mcp__context7__*",
      "mcp__plugin_context7-plugin_context7__*",
      "mcp__honeybadger__*",
      "mcp__claude_ai_github__*",
      "mcp__pencil__*",
      "mcp__figma-desktop__*",
      "mcp__devin__*",
      "mcp__figma__*",
      "mcp__sentry__*",
      "mcp__miro__*"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/key/**)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(sudo *)"
    ],
    "defaultMode": "plan"
  },
  "model": "opus",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh /Users/onodaosamu/.claude/statusline-command.sh"
  },
  "language": "japanese",
  "tui": "fullscreen",
  "voiceEnabled": true
}
